{
  "name": "@sheruq/claude-router",
  "version": "0.0.3",
  "description": "TypeScript-native Claude model router — auto-routes to Haiku/Sonnet/Opus by complexity, logs cost savings per call",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "claude-router": "./dist/proxy/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/__tests__/**/*.test.js",
    "dev": "tsc --watch",
    "proxy": "node dist/proxy/cli.js"
  },
  "keywords": [
    "claude",
    "anthropic",
    "llm",
    "router",
    "model-router",
    "ai",
    "cost-optimization",
    "haiku",
    "sonnet",
    "opus",
    "proxy"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^2.0.1",
    "hono": "^4.12.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
